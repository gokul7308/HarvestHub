# HarvestHub Frontend Environment Variables
# Copy this file to .env or .env.local for local frontend development.
# Obtain your project credentials from: Supabase Project Settings -> API

# Supabase REST endpoint URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (safe for browser distribution, protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
