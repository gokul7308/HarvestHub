# ==============================================================================
# HarvestHub - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NEVER commit production service keys or API secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client & Backend)
# ------------------------------------------------------------------------------
# Project URL obtained from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key (Safe for frontend distribution, restricted by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (ONLY for backend serverless functions, NEVER in frontend)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# Google Gemini Generative AI Configuration
# ------------------------------------------------------------------------------
# Google AI Studio API Key for Gemini 1.5 Flash assistant & insights
AI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Optional Machine Learning Service URL
# ------------------------------------------------------------------------------
# Local FastAPI serving port for Python ML regression pipeline (default 8000)
ML_SERVICE_URL=http://localhost:8000
